{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestión Inmobiliaria",
  "version": "0.2.0",
  "identifier": "com.inmobiliaria.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": " ",
        "width": 760,
        "height": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkNFQzQ2OEYxNUU2NjMKUldSajVoV1BSdXdzcG9mZE1pQXV6UjFncTlwVXhocjBYS2VYQkI5b3VQSlRvR0pEMnJlVjQvZXYK",
      "endpoints": [
        "https://github.com/fedepiero-sys/laemma/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
